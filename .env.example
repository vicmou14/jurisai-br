# Environment
JURISAI_ENV=production
JURISAI_API_KEY=troque-por-uma-chave-longa-e-aleatoria
POSTGRES_PASSWORD=troque-por-uma-senha-forte
DATABASE_URL=postgresql+psycopg://jurisai:senha@db:5432/jurisai
JURISAI_CORS_ORIGINS=https://seu-dominio.example

# OpenAI text generation
OPENAI_API_KEY=
JURISAI_TEXT_MODEL=gpt-5.6-sol

# DOCX templates
JURISAI_CODER_TEMPLATE=templates/template_coder.docx
JURISAI_ESCRITORIO_TEMPLATE=templates/template_escritorio.docx

# Retrieval sources
JURISAI_VECTOR_MODE=pgvector
JURISAI_EMBEDDING_PROVIDER=local
JURISAI_STJ_QUERY=jurisprudencia
JURISAI_STJ_ROWS=20
JURISAI_PLANALTO_URLS=
JURISAI_STF_CSV=
